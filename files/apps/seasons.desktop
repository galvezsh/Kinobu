[Desktop Entry]
Type=Application
Name=Seasons
Comment=Choose the look of your desktop: theme, icons, cursor, fonts and wallpapers
Comment[es]=Elige el aspecto de tu escritorio: tema, iconos, cursor, fuentes y fondos
Exec=@LAUNCHER@ themes
Icon=os.kinobu.Themes
Terminal=false
Categories=GNOME;GTK;Settings;DesktopSettings;
Keywords=Kinobu;Seasons;Theme;Appearance;Icons;Cursor;Fonts;Wallpaper;Dark;Light;
Keywords[es]=Kinobu;Seasons;Tema;Apariencia;Iconos;Cursor;Fuentes;Fondo;Oscuro;Claro;
StartupNotify=true
StartupWMClass=os.kinobu.Themes
